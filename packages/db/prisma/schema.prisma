// Prisma schema for the GW2 Log-Analyse-Plattform.
//
// Data model per ADR-005 (base entities) and ADR-009 (PhaseResult as its
// own table, MechanicEvent referencing PhaseResult, category enum).
//
// Auth (step 3, ADR-007, Discord provider): Account/Session/
// VerificationToken follow the standard Auth.js Prisma adapter shape
// (https://authjs.dev/getting-started/adapters/prisma) so the adapter
// works without extra mapping.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  uploadedLogs   LogFile[]
  createdInvites ProjectInvite[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members       ProjectMember[]
  invites       ProjectInvite[]
  uploadBatches UploadBatch[]

  @@map("projects")
}

/// Linear hierarchy: VIEWER < CONTRIBUTOR < ADMIN (see apps/web/src/lib/projects.ts).
enum ProjectRole {
  ADMIN
  CONTRIBUTOR
  VIEWER
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

/// Shareable invite link (/invite/<token>). Only the SHA-256 of the token is
/// stored; the plain link is shown once, when an admin creates it. Revoking
/// an invite deletes the row.
model ProjectInvite {
  id          String      @id @default(cuid())
  projectId   String
  tokenHash   String      @unique
  role        ProjectRole
  createdById String?
  expiresAt   DateTime
  /// Null = unlimited uses until expiry.
  maxUses     Int?
  useCount    Int         @default(0)
  createdAt   DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_invites")
}

model UploadBatch {
  id        String   @id @default(cuid())
  projectId String
  label     String
  createdAt DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logFiles LogFile[]

  @@map("upload_batches")
}

enum LogFileStatus {
  PENDING
  PARSING
  DONE
  FAILED
}

model LogFile {
  id                String        @id @default(cuid())
  batchId           String
  status            LogFileStatus @default(PENDING)
  storageKeyRaw     String
  storageKeyJson    String?
  externalReportUrl String?
  errorMessage      String?
  /// Null for logs uploaded before attribution existed, or once the uploader's account is gone.
  uploadedById      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  batch           UploadBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  encounterResult EncounterResult?

  @@map("log_files")
}

model EncounterResult {
  id         String    @id @default(cuid())
  logFileId  String    @unique
  bossId     String
  bossName   String
  /// EI's `isCM` flag — Normal Mode and Challenge Mode share the same
  /// bossId, so this is the only signal distinguishing them.
  isCM       Boolean   @default(false)
  success    Boolean
  durationMs Int
  /// When the fight actually happened in-game (EI's timeStartStd), not when
  /// this row was inserted — lets trends sort by real chronology regardless
  /// of upload order. Null for encounters parsed before this field existed.
  recordedAt DateTime?
  createdAt  DateTime  @default(now())

  logFile       LogFile        @relation(fields: [logFileId], references: [id], onDelete: Cascade)
  phaseResults  PhaseResult[]
  playerResults PlayerResult[]

  @@map("encounter_results")
}

model PhaseResult {
  id                  String  @id @default(cuid())
  encounterResultId   String
  name                String
  order               Int
  startMs             Int
  endMs               Int
  reached             Boolean
  success             Boolean
  playersAliveAtStart Int

  encounterResult EncounterResult @relation(fields: [encounterResultId], references: [id], onDelete: Cascade)
  mechanicEvents  MechanicEvent[]

  @@map("phase_results")
}

enum MechanicCategory {
  MISTAKE
  STEALTH
  REVEAL
  GREEN
  BOSS_SPECIFIC
}

model MechanicEvent {
  id             String           @id @default(cuid())
  phaseResultId  String
  playerResultId String?
  mechanicName   String
  category       MechanicCategory
  displayName    String
  timeMs         Int
  context        Json?

  phaseResult  PhaseResult   @relation(fields: [phaseResultId], references: [id], onDelete: Cascade)
  playerResult PlayerResult? @relation(fields: [playerResultId], references: [id], onDelete: SetNull)

  @@map("mechanic_events")
}

model PlayerResult {
  id                String  @id @default(cuid())
  encounterResultId String
  account           String
  characterName     String
  profession        String
  group             Int?
  dps               Int
  deaths            Int
  downs             Int
  role              String?

  encounterResult EncounterResult @relation(fields: [encounterResultId], references: [id], onDelete: Cascade)
  mechanicEvents  MechanicEvent[]

  @@index([encounterResultId, account])
  @@map("player_results")
}

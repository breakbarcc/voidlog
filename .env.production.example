# Template for the `.env` file docker-compose.prod.yml expects next to it
# on the VPS. Copy this to `.env` there and fill in real values — never
# commit the filled-in file. Differs from the local-dev `.env.example` in
# three ways: DATABASE_URL/REDIS_URL point at the compose service names
# ("postgres"/"redis"), not "localhost" (containers reach each other by
# service name on the compose network, not via published host ports —
# docker-compose.prod.yml doesn't even publish postgres/redis to the host);
# STORAGE_* point at R2, not MinIO; LOG_PARSER is "dps-report", not "mock".

# ---------------------------------------------------------------------------
# Postgres container credentials (docker-compose.prod.yml's `postgres`
# service reads this directly). Keep this in sync with the password embedded
# in DATABASE_URL below — they're two separate places for the same secret,
# same as in local dev's docker-compose.yml/.env.example pair.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD="generate-a-real-password-here"

# ---------------------------------------------------------------------------
# Database (ADR-005, PostgreSQL via Prisma)
# Host is the compose service name "postgres", not localhost/an external
# provider — this stack runs its own Postgres container (see
# docker-compose.prod.yml). Password must match POSTGRES_PASSWORD above.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://voidlog:generate-a-real-password-here@postgres:5432/voidlog?schema=public"

# ---------------------------------------------------------------------------
# Queue (ADR-004, Redis/BullMQ)
# Host is the compose service name "redis", same reasoning as above.
# ---------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# ---------------------------------------------------------------------------
# Object storage (ADR-003, S3-compatible) — Cloudflare R2 in production.
# Create the bucket + an API token (Account Home > R2 > Manage API Tokens)
# scoped to just that bucket. STORAGE_ENDPOINT is your account-specific R2
# endpoint: https://<account-id>.r2.cloudflarestorage.com
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="voidlog-logs"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# false/empty for R2 — path-style is only needed for local MinIO.
STORAGE_FORCE_PATH_STYLE="false"

# ---------------------------------------------------------------------------
# dps.report API (ADR-002)
# ---------------------------------------------------------------------------
DPS_REPORT_BASE_URL="https://dps.report"
DPS_REPORT_UPLOAD_PATH="/uploadContent"
DPS_REPORT_JSON_PATH="/getJson"

# Real parser, not the mock — this is production.
LOG_PARSER="dps-report"

# ---------------------------------------------------------------------------
# Auth.js with Discord provider (ADR-007)
# Use a SEPARATE Discord application from local dev (or add this domain's
# redirect URI to the existing one) — the redirect URI must match your real
# domain exactly: https://<your-domain>/api/auth/callback/discord
# Required OAuth2 scopes: identify, email.
# AUTH_SECRET signs/encrypts Auth.js session cookies — generate a fresh one
# for production, don't reuse the local-dev value:
# `openssl rand -base64 32` or `pnpm dlx auth secret`.
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_URL="https://<your-domain>"

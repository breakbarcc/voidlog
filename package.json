{
  "name": "voidlog",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "build": "pnpm --recursive --filter=./apps/* run build",
    "lint": "eslint scripts && pnpm --recursive run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --recursive run typecheck",
    "test:e2e": "dotenv -e .env -- tsx scripts/test-e2e.ts",
    "seed:test-session": "dotenv -e .env -- tsx scripts/seed-test-session.ts",
    "backfill:greens": "dotenv -e .env -- tsx scripts/backfill-greens.ts",
    "backfill:target-buff-stacks": "dotenv -e .env -- tsx scripts/backfill-target-buff-stacks.ts"
  },
  "dependencies": {
    "@voidlog/db": "workspace:*",
    "@voidlog/shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
